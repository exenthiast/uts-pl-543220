# ==============================================================================
# Berkas Konfigurasi Lingkungan Docker Compose (.env.example)
# Salin berkas ini menjadi .env sebelum menjalankan docker compose up -d --build
# ==============================================================================

# Pengaturan Aplikasi Laravel Backend
APP_NAME="Katalog Pustaka"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Konfigurasi Basis Data PostgreSQL (Komunikasi via Service Name 'db')
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=uts_db
DB_USERNAME=uts_user
DB_PASSWORD=secret_password

# Port Mapping Host
BACKEND_PORT=8000
FRONTEND_PORT=80
